# Kubespray Sample Inventory (inventory/mycluster/inventory.ini)
[all]
k8s-control-01 ansible_host=10.10.10.10 ip=10.10.10.10 etcd_member_name=etcd1
k8s-worker-01  ansible_host=10.10.10.11 ip=10.10.10.11
k8s-worker-02  ansible_host=10.10.10.12 ip=10.10.10.12

[kube_control_plane]
k8s-control-01

[etcd]
k8s-control-01

[kube_node]
k8s-worker-01
k8s-worker-02

[calico_rr]

[k8s_cluster:children]
kube_control_plane
kube_node
calico_rr
