# Declarative configuration for RKE2 Server (/etc/rancher/rke2/config.yaml)
write-kubeconfig-mode: "0644"
tls-san:
  - "10.10.10.10"
  - "rke2-server-01"
  - "rke2-server-01.lab.local"
  - "127.0.0.1"

# CNI configuration (Canal, Calico, or Cilium)
cni:
  - "canal"

# CIS benchmark profile (Optional - strict hardening)
# profile: "cis-1.23"

# Optional component toggles
# disable:
#   - rke2-ingress-nginx
